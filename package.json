{
  "name": "reploom-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "test:packages": "node scripts/test-packages.mjs",
    "compiler:verify": "node scripts/verify-vendor.mjs && node scripts/verify-compiler.mjs",
    "compiler:build": "node scripts/build-playground-compiler.mjs",
    "pack:all": "node scripts/pack.mjs",
    "lint": "oxlint --deny-warnings packages scripts tests examples apps/demo crates/compiler/engine.mjs benchmarks",
    "format": "pnpm lint:fix && oxfmt --write packages benchmarks scripts tests examples apps/demo crates/compiler/engine.mjs *.json *.yaml .github .oxfmtrc.json .oxlintrc.json && pnpm lint:fix",
    "format:check": "oxfmt --check packages benchmarks scripts tests examples apps/demo crates/compiler/engine.mjs *.json *.yaml .github .oxfmtrc.json .oxlintrc.json",
    "lint:rust": "cargo clippy --locked --manifest-path crates/compiler/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "cargo test --locked --manifest-path crates/compiler/Cargo.toml",
    "format:rust": "cargo fmt --manifest-path crates/compiler/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path crates/compiler/Cargo.toml --check",
    "demo": "node scripts/serve.mjs apps/demo/dist",
    "test:prepare": "node tests/fixtures/regression/build.mjs && node tests/fixtures/features/build.mjs && pnpm test:packages",
    "audit:packages": "node scripts/audit-packages.mjs",
    "test:performance": "REPLOOM_PERFORMANCE_GATES=1 pnpm test:browser tests/browser/execution.spec.ts",
    "lint:fix": "oxlint --fix packages scripts tests examples apps/demo crates/compiler/engine.mjs benchmarks",
    "bench:runtime": "node benchmarks/runtime.mjs",
    "bench:browser": "node benchmarks/browser.mjs",
    "bench:bindings": "node benchmarks/bindings.mjs",
    "bench:parser": "node benchmarks/parser.mjs",
    "bench:compiler-startup": "node benchmarks/compiler-startup.mjs",
    "bench:typecheck": "node benchmarks/typecheck.mjs",
    "bench:typecheck-memory": "node benchmarks/typecheck-memory.mjs",
    "bench:editor": "node benchmarks/editor/run.mjs",
    "bench:syntax": "node benchmarks/syntax-channel.mjs",
    "audit:publication": "node scripts/audit-publication.mjs"
  },
  "devDependencies": {
    "@jridgewell/gen-mapping": "0.3.13",
    "@jridgewell/remapping": "2.3.5",
    "@jridgewell/trace-mapping": "0.3.31",
    "@lezer/javascript": "1.5.6",
    "@playwright/test": "1.65.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "@tsrs/wasm": "0.25.0-ts7.1.0-beta",
    "@types/estree": "1.0.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@yongsk0066/reploom": "workspace:*",
    "@yongsk0066/reploom-build": "workspace:*",
    "@yongsk0066/reploom-ui": "workspace:*",
    "acorn": "8.19.0",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "eslint-scope": "9.1.2",
    "magic-string": "1.4.5",
    "oxc-transform": "0.159.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-refresh": "0.19.0",
    "toastify-js": "1.12.0",
    "turbo": "2.11.11",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}
