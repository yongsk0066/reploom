{
  "name": "reploom-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "pnpm --filter @reploom/tests run test",
    "test:browser": "pnpm --filter @reploom/tests run test:browser",
    "test:packages": "pnpm --filter @reploom/tests run test:packages",
    "compiler:verify": "node scripts/verify-vendor.mjs && node scripts/verify-compiler.mjs",
    "compiler:build": "node scripts/build-playground-compiler.mjs",
    "pack:all": "node scripts/pack.mjs",
    "lint": "oxlint --deny-warnings packages scripts tests apps/demo crates/compiler/engine.mjs benchmarks",
    "format": "pnpm lint:fix && oxfmt --write packages benchmarks scripts tests apps/demo crates/compiler/engine.mjs *.json *.yaml .github .oxfmtrc.json .oxlintrc.json && pnpm lint:fix",
    "format:check": "oxfmt --check packages benchmarks scripts tests apps/demo crates/compiler/engine.mjs *.json *.yaml .github .oxfmtrc.json .oxlintrc.json",
    "lint:rust": "cargo clippy --locked --manifest-path crates/compiler/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "cargo test --locked --manifest-path crates/compiler/Cargo.toml",
    "format:rust": "cargo fmt --manifest-path crates/compiler/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path crates/compiler/Cargo.toml --check",
    "demo": "node scripts/serve.mjs apps/demo/dist",
    "test:prepare": "pnpm --filter @reploom/tests run prepare:site",
    "audit:packages": "pnpm --filter @reploom/tests run audit:packages",
    "test:performance": "REPLOOM_PERFORMANCE_GATES=1 pnpm test:browser tests/browser/execution.spec.ts",
    "lint:fix": "oxlint --fix packages scripts tests apps/demo crates/compiler/engine.mjs benchmarks",
    "bench:runtime": "pnpm --filter @reploom/benchmarks run runtime",
    "bench:loading": "pnpm --filter @reploom/benchmarks run loading",
    "bench:browser": "pnpm --filter @reploom/benchmarks run browser",
    "bench:bindings": "pnpm --filter @reploom/benchmarks run bindings",
    "bench:parser": "pnpm --filter @reploom/benchmarks run parser",
    "bench:compiler-startup": "pnpm --filter @reploom/benchmarks run compiler-startup",
    "bench:typecheck": "pnpm --filter @reploom/benchmarks run typecheck",
    "bench:typecheck-memory": "pnpm --filter @reploom/benchmarks run typecheck-memory",
    "bench:editor": "pnpm --filter @reploom/benchmarks run editor",
    "bench:syntax": "pnpm --filter @reploom/benchmarks run syntax",
    "bench:interaction": "pnpm --filter @reploom/benchmarks run interaction",
    "audit:publication": "node scripts/audit-publication.mjs"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "turbo": "2.11.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}
